//  https://github.com/m3tozz/FastCat
{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "source": "~/.config/fastfetch/ascii.txt",
            "color": {
        "1": "0"
    }
    },
    "display": {
        "separator": " ",
        "color": {
            "keys": "red"
        }
    },
    "modules": [
        {
            "type": "title",
            "key": " ",
            "keyColor": "white",
            "format": "{1}@{2}",
            "color": {
                "key": "red"
            }
        },
        {
            "type": "break",
        },
        {
            "type": "os",
            "key": " ",
            "keyColor": "1",
        },
        {
            "type": "kernel",
            "key": " ",
            "keyColor": "1",
        },
        {
            "type": "packages",
            "key": " ",
            "keyColor": "1",
        },
        {
            "type": "shell",
            "key": " ",
            "keyColor": "1",
        },
        {
            "type": "terminal",
            "key": " ",
            "keyColor": "1",
        },
        {
            "type": "de",
            "key": " ",
            "keyColor": "1"
        },
        {
            "type": "wm",
            "key": " ",
            "keyColor": "1",
        },
        {
            "type": "uptime",
            "key": " ",
            "keyColor": "1",
        },
        {
            "type": "break",
        },
        {
            "type": "datetime",
            "format": "{1}-{3}-{11}",
            "key": " ",
            "keyColor": "1",
        },
        ]
}
